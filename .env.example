# Optional. Web3Forms access key (https://web3forms.com) so the inquiry form delivers to your inbox.
# Without it, the form falls back to opening the visitor's email app with the brief pre-filled.
WEB3FORMS_ACCESS_KEY=
# Public site URL, used for OpenGraph/canonical metadata.
NEXT_PUBLIC_SITE_URL=https://aryanpol.dev
# Recommended. A GitHub token for the live stats card (read-only; no repository permissions needed).
# With it: exact contribution count + heatmap, languages by code size, and no anonymous rate limit.
# Create one at https://github.com/settings/personal-access-tokens/new (fine-grained, "Public repositories" access).
GITHUB_TOKEN=
